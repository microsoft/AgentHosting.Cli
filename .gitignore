bin/
obj/
tmp/
.vs/
*.user
*.suo
node_modules/
dist/
bundles/

# Local build output. `dotnet pack -o artifacts/nupkg` lands here, and the OneBranch
# pipelines collect packages with a `**/*.nupkg` glob — a committed package would be
# picked up and published alongside the real build output.
artifacts/
*.nupkg
*.snupkg

# Live end-to-end run output. `msagent-e2e run` writes a transcript, reports and a
# ledger per run, all of which name local paths and the environments it signed in to.
.runs/

# Local secrets (never commit)
appsettings.Local.json
customer-configs.json

# AuthSidecar real/local config holds sensitive AzureAd values — never commit.
# appsettings.json (committed) carries only placeholders.
src/AuthSidecar/appsettings.Development.json

# Local deployment fixtures — .ah holds runtime records referencing real Azure bots; never commit.
.ah/
