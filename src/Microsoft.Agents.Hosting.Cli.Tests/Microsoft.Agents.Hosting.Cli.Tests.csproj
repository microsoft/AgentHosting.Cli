<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Agents.Core" ExcludeAssets="analyzers" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Microsoft.Agents.Hosting.Cli.Commands\Microsoft.Agents.Hosting.Cli.Commands.csproj" />
	<ProjectReference Include="..\Microsoft.Agents.Hosting.Cli.E2E\Microsoft.Agents.Hosting.Cli.E2E.Tests.csproj" />
	<ProjectReference Include="..\Microsoft.Agents.Hosting.Cli\Microsoft.Agents.Hosting.Cli.csproj" />
    <ProjectReference Include="..\Microsoft.Agents.Hosting.Cli.Core\Microsoft.Agents.Hosting.Cli.Core.csproj" />
    <ProjectReference Include="..\Microsoft.Agents.Hosting.Cli.CopilotStudio\Microsoft.Agents.Hosting.Cli.CopilotStudio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Link the provisional ABS conformance fixtures into the output so the contract runner reads
         their LF-pinned raw bytes from the test base directory. -->
    <None Include="..\AgentHostCli.Conformance\fixtures\*.json" Link="ConformanceFixtures\%(FileName)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="RemoveTransitiveAgentsCoreAnalyzer" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Analyzer.Filename)' == 'Microsoft.Agents.Core.Analyzers'" />
    </ItemGroup>
  </Target>

</Project>
