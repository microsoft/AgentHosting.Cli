<Project>

  <PropertyGroup>
    <Authors Condition="'$(Authors)' == ''">Microsoft</Authors>
    <Company Condition="'$(Company)' == ''">Microsoft</Company>
    <PackageTags Condition="'$(PackageTags)' == ''">AgentsSDK M365 A365 CopilotStudio</PackageTags>
    <Copyright Condition="'$(Copyright)' == ''">© Microsoft Corporation. All rights reserved.</Copyright>
    <PackageIcon Condition="'$(PackageIcon)' == ''">copilotstudio_128x128-thumb.png</PackageIcon>
    <PackageProjectUrl Condition="'$(PackageProjectUrl)' == ''">https://github.com/microsoft/AgentHosting.Cli</PackageProjectUrl>
    <PackageLicenseUrl Condition="'$(PackageLicenseUrl)' == ''">https://github.com/microsoft/AgentHosting.Cli?tab=MIT-1-ov-file#readme</PackageLicenseUrl>
    <RepositoryUrl Condition="'$(RepositoryUrl)' == ''">https://github.com/microsoft/AgentHosting.Cli</RepositoryUrl>
    <RepositoryType>git</RepositoryType> 
    <NoWarn>$(NoWarn);NU1701;NU1900;NU5125;NU5104</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)\Images\copilotstudio_128x128-thumb.png" Link="copilotstudio_128x128-thumb.png" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>